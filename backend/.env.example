# 复制为 backend/.env 后按需修改
# ---- 抽取与叙述用哪个模型 ----
TIJI_LLM_PROVIDER=mock              # mock（离线词表）| anthropic（Claude）| compat（国产模型等 OpenAI 兼容接口）
TIJI_LLM_FALLBACK=mock              # 真实模型失败时退回离线词表并在界面标注；评测脚本会自动设为 none
TIJI_LLM_TIMEOUT=90

# ---- anthropic ----
# ANTHROPIC_API_KEY=sk-ant-...       # 或 ANTHROPIC_AUTH_TOKEN
TIJI_ANTHROPIC_MODEL=claude-opus-5
TIJI_ANTHROPIC_EFFORT_EXTRACT=medium   # low | medium | high | xhigh | max
TIJI_ANTHROPIC_EFFORT_NARRATIVE=low
TIJI_ANTHROPIC_FALLBACKS=default       # 服务端拒答回退；off = 关闭

# ---- compat（国产模型，OpenAI 兼容 /chat/completions；以服务商文档为准）----
# DeepSeek：  TIJI_COMPAT_BASE_URL=https://api.deepseek.com                           TIJI_COMPAT_MODEL=deepseek-chat
# 通义千问：   TIJI_COMPAT_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   TIJI_COMPAT_MODEL=qwen-plus
# 智谱 GLM：  TIJI_COMPAT_BASE_URL=https://open.bigmodel.cn/api/paas/v4                TIJI_COMPAT_MODEL=glm-4-plus
# TIJI_COMPAT_API_KEY=...
TIJI_COMPAT_JSON_MODE=1

# 本机模型（TIJI_LLM_PROVIDER=ollama）：患者原话不离开这台电脑，适合私有化部署与可用性测试
# 需先安装 Ollama 并拉取模型；上下文默认 16384（Ollama 默认 4096 装不下抽取提示词）
# TIJI_OLLAMA_BASE_URL=http://localhost:11434
# TIJI_OLLAMA_MODEL=qwen3:4b
# TIJI_OLLAMA_NUM_CTX=16384
# TIJI_OLLAMA_THINK=false      # qwen3 用 false；gpt-oss 关不掉思考，用 low

# ---- 其它 ----
# 本模板保留生产门槛；模拟演示请用 make demo（独立数据库与随机账号）。
# 当前协议仍为 AI 草案，production 模式会拒绝加载。
TIJI_MODE=production
TIJI_DATABASE_URL=sqlite:///./tiji.db
TIJI_DEFAULT_PROTOCOL=lbp_adult_v0.2
TIJI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TIJI_ENABLE_DEV=0                   # 关闭 /api/dev/seed

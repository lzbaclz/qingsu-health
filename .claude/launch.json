{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--port",
        "8000",
        "--app-dir",
        "backend",
        "--reload",
        "--reload-dir",
        "backend/app"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    }
  ]
}